    <!-- ===== Dungeon names and descriptions ===== -->
    <string name="dungeon_imp_cavern_name">Wichtelhöhle</string>
    <string name="dungeon_imp_cavern_desc">Eine flache Höhle voller schelmischer Wichtel. Ideal für absolute Anfänger!</string>
    <string name="dungeon_goblin_cave_name">Koboldhöhle</string>
    <string name="dungeon_goblin_cave_desc">Eine dunkle Höhle, in der es von Kobolden und Riesenratten wimmelt. Ein guter Ort für angehende Abenteurer, um zu trainieren.</string>
    <string name="dungeon_spider_den_name">Spinnenhöhle</string>
    <string name="dungeon_spider_den_desc">Eine mit Spinnweben gefüllte Höhle, in der es von giftigen Spinnen nur so wimmelt. Nehmt unbedingt ein Gegengift mit!</string>
    <string name="dungeon_bandit_camp_name">Räuberlager</string>
    <string name="dungeon_bandit_camp_desc">Ein Versteck für Räuber und Schurken in der Wildnis. Passt auf Euren Geldbeutel auf!</string>
    <string name="dungeon_undead_crypt_name">Gruft der Untoten</string>
    <string name="dungeon_undead_crypt_desc">Eine uralte Begräbnisstätte, in der die Toten keine Ruhe finden. Hütet Euch vor der dunklen Magie!</string>
    <string name="dungeon_fortress_ruins_name">Festungsruinen</string>
    <string name="dungeon_fortress_ruins_desc">Die zerfallenden Überreste einer alten Burg, die heute von Rittern und Soldaten bewacht wird.</string>
    <string name="dungeon_orc_stronghold_name">Orkfestung</string>
    <string name="dungeon_orc_stronghold_desc">Eine befestigte Orksiedlung tief in den Bergen. Nur die Mutigsten wagen sich dorthin.</string>
    <string name="dungeon_volcanic_depths_name">Vulkanische Tiefen</string>
    <string name="dungeon_volcanic_depths_desc">Eine glühend heiße Höhle, bewohnt von Höllenhunden und kleinen Dämonen. Die Hitze ist unerträglich!</string>
    <string name="dungeon_dragon_lair_name">Drachenhort</string>
    <string name="dungeon_dragon_lair_desc">Die legendäre Heimat der grünen Drachen. Nur Meisterkrieger überstehen diese Herausforderung.</string>
    <string name="dungeon_farm_name">Bauernhof</string>
    <string name="dungeon_farm_desc">Ein friedlicher Bauernhof mit Vieh. Ideal für Anfänger, die sich mit Lebensmitteln versorgen möchten!</string>
    <string name="dungeon_infernal_stronghold_name">Höllenfestung</string>
    <string name="dungeon_infernal_stronghold_desc">Eine Festung aus Feuer und Schwefel, beherrscht von Dämonen und Höllenhunden. Schon die bloße Hitze kann Unvorbereitete töten.</string>
    <string name="dungeon_ancient_temple_name">Antiker Tempel</string>
    <string name="dungeon_ancient_temple_desc">Ein antiker Tempel, der von den mächtigsten Wesen des Reiches bewacht wird. Nur die stärksten Krieger wagen es, ihn zu betreten.</string>
    <string name="dungeon_void_rift_name">Leerenriss</string>
    <string name="dungeon_void_rift_desc">Ein Riss in der Realität, durch den Leerenwesen in die Sterblichenwelt eindringen.</string>
    <string name="dungeon_frozen_citadel_name">Gefrorene Zitadelle</string>
    <string name="dungeon_frozen_citadel_desc">Eine uralte Festung, die von einem Gletscher eingeschlossen ist und deren Verteidiger in ewiger Wacht eingefroren sind.</string>
    <string name="dungeon_abyssal_throne_name">Abyssthron</string>
    <string name="dungeon_abyssal_throne_desc">Der tiefste Punkt der bekannten Welt, regiert von Leerenlords seit Anbeginn der Zeit.</string>

    <!-- ===== Event dungeon names ===== -->
    <string name="dungeon_sunspire_name">The Sunspire</string> <!-- untranslated -->
    <string name="dungeon_sunspire_desc">A sun-tower ruin cracked open by the solstice, spilling heat spirits into the region. Part of the Sunspire Solstice event.</string> <!-- untranslated -->
    <string name="dungeon_hollowfen_name">The Hollowfen</string> <!-- untranslated -->
    <string name="dungeon_hollowfen_desc">A mist-drowned marsh of sunken barrows where the harvest dead walk. Part of the Gloomharvest event.</string> <!-- untranslated -->
    <string name="dungeon_cloud_kingdom_name">Cloud Kingdom</string> <!-- untranslated -->
    <string name="dungeon_cloud_kingdom_desc">A realm above the clouds, reached by climbing a legendary beanstalk. Giants roam vast floating islands, sky serpents drift between the cloudbanks, and storm imps crackle with restless energy. Few have seen it. Fewer still have returned to speak of it.</string> <!-- untranslated -->
    <string name="dungeon_blightwood_name">The Blightwood</string> <!-- untranslated -->
    <string name="dungeon_blightwood_desc">A rotting forest deep past the Hollowfen, where the Gloomharvest\'s strongest horrors gather. Part of the Gloomharvest event.</string> <!-- untranslated -->

    <!-- ===== Raid bosses ===== -->
    <string name="boss_king_black_dragon_name">König der Schwarzdrachen</string>
    <string name="boss_king_black_dragon_desc">Der legendäre dreiköpfige Drache, gefürchtet im ganzen Reich.</string>
    <string name="boss_demon_lord_name">Dämonenfürst</string>
    <string name="boss_demon_lord_desc">Ein uralter Dämon aus dem Abgrund, Meister der dunklen Magie.</string>
    <string name="boss_kraken_name">Kraken</string> <!-- untranslated -->
    <string name="boss_kraken_desc">Der Schrecken der Tiefsee, ein kolossales Seeungeheuer.</string>
    <string name="boss_balrog_name">Gothic Ember</string> <!-- untranslated -->
    <string name="boss_balrog_desc">Ein uralter Dämon aus Flamme und Schatten, erwacht aus seinem Schlaf tief unter der Erde.</string>
    <string name="boss_void_sovereign_name" translatable="false">Der Gebieter der Leere</string>
    <string name="boss_void_sovereign_desc">Die ursprüngliche Entität hinter den Leerenrissen. Unermesslich alt, betrachtet sie sterbliche Herausforderer mit Verachtung.</string>
    <string name="boss_sol_invictus_name">Sol Invictus, the Sundered Flame</string> <!-- untranslated -->
    <string name="boss_sol_invictus_desc">A shard of the sun itself, torn loose from the Sunspire ruin. Only the boldest warriors dare approach.</string> <!-- untranslated -->
    <string name="boss_the_hollow_king_name">The Hollow King</string> <!-- untranslated -->
    <string name="boss_the_hollow_king_desc">The headless sovereign of the Gloomharvest, riding out from the Blightwood to reap what the living have sown.</string> <!-- untranslated -->
    <string name="boss_the_vault_guardian_name">The Vault Guardian</string> <!-- untranslated -->
    <string name="boss_the_vault_guardian_desc">A colossus of living gold, woken by the lighting of the Eternal Flame. Only patrons of the Grand Monument may face it.</string> <!-- untranslated -->

    <!-- ===== Expedition-unlocked dungeon names ===== -->
    <string name="dungeon_collapsed_mine_name">Eingestürzte Mine</string>
    <string name="dungeon_collapsed_mine_desc">Eine riesige Höhle unter den Kupferminen. Höhlentrolle und Steingolem heimsuchen das Trümmerfeld, und Riesenspinnen spinnen Netze in den eingestürzten Schächten.</string>
    <string name="dungeon_shadow_den_name">Schattenhöhle</string>
    <string name="dungeon_shadow_den_desc">Ein Netz unterirdischer Kammern, das von der Diebesgilde der Region genutzt wird. Schurken, Assassinen und Schattenwesen lauern in jeder Ecke.</string>
    <string name="dungeon_abyssal_ruins_name">Abgrundtiefe Ruinen</string>
    <string name="dungeon_abyssal_ruins_desc">Alte Ruinen, die gleichzeitig ober- und unterhalb der Sterblichkeitsebene existieren. Seltsame, abgründige Kreaturen tauchen in die Realität ein und verschwinden wieder.</string>
    <string name="dungeon_ancient_forest_ruins_name">Alte Waldruinen</string>
    <string name="dungeon_ancient_forest_ruins_desc">Steinruinen, die vom Urwald verschluckt wurden, jetzt von wilden Kreaturen und rachsüchtigen Geistern der Druiden heimgesucht.</string>
    <string name="dungeon_ancient_forge_name">Alte Schmiede</string>
    <string name="dungeon_ancient_forge_desc">Eine riesige Zwergenschmiede, die seit Jahrhunderten ununterbrochen brennt. Feuerelementare und Schmiedewächter schützen ihre Geheimnisse.</string>
    <string name="dungeon_arcane_ruins_name">Arkane Ruinen</string>
    <string name="dungeon_arcane_ruins_desc">Die funktionalen unterirdischen Kammern eines zerstörten Zaubererturms. Magische Konstrukte und verzauberte Wächter patrouillieren noch immer durch die Hallen.</string>
    <string name="dungeon_corrupted_sanctum_name">Verdorbenes Heiligtum</string>
    <string name="dungeon_corrupted_sanctum_desc">Ein schattendurchtränktes Heiligtum im Herzen des verdorbenen Waldes. Dunkle Priester und verdorbene Bestien bewachen ein altes Böses.</string>
    <string name="dungeon_drowned_temple_name">Versunkener Tempel</string>
    <string name="dungeon_drowned_temple_desc">Ein versunkener Tempel unter einer Meereshöhle, dessen Hallen mit Wasser gefüllt sind und von allerlei Meereskreaturen heimgesucht werden.</string>
    <string name="dungeon_rogue_sanctum_name">Gaunersanktum</string>
    <string name="dungeon_rogue_sanctum_desc">Das innere Refugium der Gilde, zugänglich nur für bewährte Mitglieder.</string>
    <string name="dungeon_guild_of_shadows_name">Schattengilde</string>
    <string name="dungeon_guild_of_shadows_desc">Das innerste Heiligtum der Diebsgilde, bewacht von ihren gefährlichsten Vollstreckern.</string>
</resources>
