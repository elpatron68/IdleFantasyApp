    <!-- ===== Dungeon names and descriptions ===== -->
    <string name="dungeon_imp_cavern_name">Caverne des diablotins</string>
    <string name="dungeon_imp_cavern_desc">Une grotte peu profonde peuplée de petits diablotins espiègles. Idéal pour les débutants !</string>
    <string name="dungeon_goblin_cave_name">Cave des gobelins</string>
    <string name="dungeon_goblin_cave_desc">Une grotte sombre infestée de gobelins et de rats géants. Un endroit idéal pour que les nouveaux aventuriers s’entraînent.</string>
    <string name="dungeon_spider_den_name">Repaire des araignées</string>
    <string name="dungeon_spider_den_desc">Une caverne remplie de toiles d’araignées, grouillant d’araignées venimeuses. N’oubliez pas l’antivenin !</string>
    <string name="dungeon_bandit_camp_name">Camp de bandits</string>
    <string name="dungeon_bandit_camp_desc">Un repaire de voleurs et de brigands en pleine nature. Surveillez bien votre bourse !</string>
    <string name="dungeon_undead_crypt_name">Cryptes des morts-vivants</string>
    <string name="dungeon_undead_crypt_desc">Une ancienne nécropole où les morts refusent de reposer en paix. Méfiez-vous de la magie noire !</string>
    <string name="dungeon_fortress_ruins_name">Ruines de la forteresse</string>
    <string name="dungeon_fortress_ruins_desc">Les ruines délabrées d’un ancien château, maintenant gardées par des chevaliers et des soldats.</string>
    <string name="dungeon_orc_stronghold_name">Forteresse des orcs</string>
    <string name="dungeon_orc_stronghold_desc">Une forteresse orc située au cœur des montagnes. Seuls les braves osent y entrer.</string>
    <string name="dungeon_volcanic_depths_name">Profondeurs volcaniques</string>
    <string name="dungeon_volcanic_depths_desc">Une cavité brûlante habitée par des chiens de feu et des démons mineurs. La chaleur y est insupportable !</string>
    <string name="dungeon_dragon_lair_name">Repaire du dragon</string>
    <string name="dungeon_dragon_lair_desc">La demeure légendaire des dragons verts. Seuls les maîtres guerriers survivent à ce défi.</string>
    <string name="dungeon_farm_name">Ferme</string>
    <string name="dungeon_farm_desc">Une ferme paisible avec du bétail. Parfait pour les débutants souhaitant récolter de la nourriture !</string>
    <string name="dungeon_infernal_stronghold_name">Forteresse infernale</string>
    <string name="dungeon_infernal_stronghold_desc">Une forteresse de feu et de soufre, contrôlée par des démons et des chiens de l’enfer. La chaleur seule peut tuer les non préparés.</string>
    <string name="dungeon_ancient_temple_name">Temple ancien</string>
    <string name="dungeon_ancient_temple_desc">Un temple ancien gardé par les créatures les plus puissantes du royaume. Seuls les guerriers les plus forts osent y entrer.</string>
    <string name="dungeon_void_rift_name">Faille du Vide</string>
    <string name="dungeon_void_rift_desc">Une déchirure dans la réalité d\'où des créatures du vide se déversent dans le monde mortel.</string>
    <string name="dungeon_frozen_citadel_name">Citadelle Gelée</string>
    <string name="dungeon_frozen_citadel_desc">Une forteresse ancestrale enfermée dans un glacier, ses défenseurs figés dans une veille éternelle.</string>
    <string name="dungeon_abyssal_throne_name">Trône Abyssal</string>
    <string name="dungeon_abyssal_throne_desc">Le point le plus profond du monde connu, gouverné par des seigneurs du vide depuis l\'aube des temps.</string>

    <!-- ===== Event dungeon names ===== -->
    <string name="dungeon_sunspire_name">La Flèche du Soleil</string>
    <string name="dungeon_sunspire_desc">Les ruines d\'une tour solaire, fendues par le solstice, déversant des esprits de chaleur dans la région. Fait partie de l\'événement du Solstice de la Flèche du Soleil.</string>
    <string name="dungeon_hollowfen_name">The Hollowfen</string> <!-- untranslated -->
    <string name="dungeon_hollowfen_desc">A mist-drowned marsh of sunken barrows where the harvest dead walk. Part of the Gloomharvest event.</string> <!-- untranslated -->
    <string name="dungeon_cloud_kingdom_name">Cloud Kingdom</string> <!-- untranslated -->
    <string name="dungeon_cloud_kingdom_desc">A realm above the clouds, reached by climbing a legendary beanstalk. Giants roam vast floating islands, sky serpents drift between the cloudbanks, and storm imps crackle with restless energy. Few have seen it. Fewer still have returned to speak of it.</string> <!-- untranslated -->
    <string name="dungeon_blightwood_name">The Blightwood</string> <!-- untranslated -->
    <string name="dungeon_blightwood_desc">A rotting forest deep past the Hollowfen, where the Gloomharvest\'s strongest horrors gather. Part of the Gloomharvest event.</string> <!-- untranslated -->

    <!-- ===== Raid bosses ===== -->
    <string name="boss_king_black_dragon_name">Roi dragon noir</string>
    <string name="boss_king_black_dragon_desc">Le légendaire dragon à trois têtes, craint dans tout le royaume.</string>
    <string name="boss_demon_lord_name">Seigneur démon</string>
    <string name="boss_demon_lord_desc">Un ancien démon des abysses, maître de la magie noire.</string>
    <string name="boss_kraken_name">Kraken</string> <!-- untranslated -->
    <string name="boss_kraken_desc">La terreur des mers profondes, un monstre marin colossal.</string>
    <string name="boss_balrog_name">Balrog</string> <!-- untranslated -->
    <string name="boss_balrog_desc">Un ancien démon de flammes et d\'ombres, réveillé de son sommeil profond sous la terre.</string>
    <string name="boss_void_sovereign_name">Le Souverain du Vide</string>
    <string name="boss_void_sovereign_desc">L\'entité primordiale derrière les failles du vide. Ancienne au-delà de toute mesure, elle considère les provocateurs mortels avec mépris.</string>
    <string name="boss_sol_invictus_name">Sol Invictus, la Flamme Brisée</string>
    <string name="boss_sol_invictus_desc">Un éclat du soleil lui-même, arraché aux ruines de la Flèche du Soleil. Seuls les guerriers les plus audacieux osent s\'en approcher.</string>
    <string name="boss_the_hollow_king_name">The Hollow King</string> <!-- untranslated -->
    <string name="boss_the_hollow_king_desc">The headless sovereign of the Gloomharvest, riding out from the Blightwood to reap what the living have sown.</string> <!-- untranslated -->
    <string name="boss_the_vault_guardian_name">The Vault Guardian</string> <!-- untranslated -->
    <string name="boss_the_vault_guardian_desc">A colossus of living gold, woken by the lighting of the Eternal Flame. Only patrons of the Grand Monument may face it.</string> <!-- untranslated -->

    <!-- ===== Expedition-unlocked dungeon names ===== -->
    <string name="dungeon_collapsed_mine_name">Mine effondrée</string>
    <string name="dungeon_collapsed_mine_desc">Une vaste caverne sous les mines de cuivre. Des trolls des cavernes et des golems de pierre hantent les décombres, et de grandes araignées tissent leurs toiles dans les galeries effondrées.</string>
    <string name="dungeon_shadow_den_name">Repaire des ombres</string>
    <string name="dungeon_shadow_den_desc">Un réseau de chambres souterraines utilisé par la guilde des voleurs de la région. Des brigands, des assassins et des créatures des ombres se tapissent dans chaque recoin.</string>
    <string name="dungeon_abyssal_ruins_name">Ruines abyssales</string>
    <string name="dungeon_abyssal_ruins_desc">D’anciennes ruines qui existent simultanément au-dessus et en dessous du plan mortel. D’étranges créatures abyssales se matérialisent et disparaissent de la réalité.</string>
    <string name="dungeon_ancient_forest_ruins_name">Ruines de la forêt ancienne</string>
    <string name="dungeon_ancient_forest_ruins_desc">Des ruines de pierre engloutries par la forêt primordiale, maintenant hantées par des créatures sauvages et des esprits vengeurs de druides.</string>
    <string name="dungeon_ancient_forge_name">Forge ancienne</string>
    <string name="dungeon_ancient_forge_desc">Une immense forge naine qui brûle depuis des siècles sans s’arrêter. Des élémentaires de feu et des gardiens de forge protègent ses secrets.</string>
    <string name="dungeon_arcane_ruins_name">Ruines arcanes</string>
    <string name="dungeon_arcane_ruins_desc">Les chambres souterraines fonctionnelles d’une tour de magicien détruite. Des constructions magiques et des gardiens enchantés patrouillent encore ses couloirs.</string>
    <string name="dungeon_corrupted_sanctum_name">Sanctuaire corrompu</string>
    <string name="dungeon_corrupted_sanctum_desc">Un sanctuaire baigné d’ombre au cœur de la canopée corrompue. Des prêtres sombres et des bêtes corrompues gardent un ancien mal.</string>
    <string name="dungeon_drowned_temple_name">Temple englouti</string>
    <string name="dungeon_drowned_temple_desc">Un temple submergé sous la grotte marine, ses salles remplies d’eau et de créatures marines qui en ont fait leur demeure.</string>
    <string name="dungeon_rogue_sanctum_name">Sanctuaire des Malfrats</string>
    <string name="dungeon_rogue_sanctum_desc">Le refuge intérieur de la guilde, accessible uniquement aux membres éprouvés.</string>
    <string name="dungeon_guild_of_shadows_name">Guilde des Ombres</string>
    <string name="dungeon_guild_of_shadows_desc">Le sanctuaire le plus profond de la guilde des voleurs, gardé par ses exécuteurs les plus redoutables.</string>
</resources>
